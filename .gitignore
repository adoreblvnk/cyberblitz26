.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/
env/
.uv-cache/

# --- Third-party agent skills -------------------------------------------
# Vendored from upstream repos, pinned by skills-lock.json. Regenerate with
# the skills installer rather than tracking ~3.3MB of duplicated content.
.agents/skills/
.claude/skills/

# --- Derived extraction scratch dirs -------------------------------------
# Provably byte-identical unzip output of unreliable-narrator.epub.
**/work/
# ...except gate-zero, whose work/ holds sw.js + dispatch.html fetched from
# the live CTF service. Those URLs are dead now, so it is the only copy.
!web/gate-zero/work/

